{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/*.egg-info": true
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/node_modules": true,
        "**/*.egg-info": true
    }
}
